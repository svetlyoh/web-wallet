diff --git a/ui/src/styles/streaming-mode.css b/ui/src/styles/streaming-mode.css
new file mode 100644
index 00000000..588f1bba
--- /dev/null
+++ b/ui/src/styles/streaming-mode.css
@@ -0,0 +1,92 @@
+/* Streaming Mode changes only shell layout and reading styles. It deliberately
+   leaves OpenClaw's navigation, overlays, and chat composer behavior untouched. */
+.sidebar-streaming-toggle,
+.topbar-streaming-toggle {
+  min-height: 36px;
+}
+
+.sidebar-streaming-toggle {
+  width: 100%;
+  margin-bottom: 4px;
+}
+
+.shell--streaming,
+.shell--streaming.shell--nav-collapsed {
+  --shell-topbar-height: 58px;
+  --shell-nav-width: 0px;
+  grid-template-columns: minmax(0, 1fr);
+  grid-template-rows: var(--shell-topbar-height) minmax(0, 1fr);
+  grid-template-areas:
+    "topbar"
+    "content";
+}
+
+.shell--streaming > .shell-nav,
+.shell--streaming > .shell-nav-backdrop,
+.shell--streaming > .shell-chrome-controls {
+  display: none;
+}
+
+.shell--streaming .topbar {
+  display: flex;
+}
+
+.shell--streaming .topbar .topbar-nav-toggle {
+  display: none;
+}
+
+.shell--streaming .topnav-shell {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  gap: 10px;
+}
+
+.shell--streaming .topnav-shell__content,
+.shell--streaming .topbar-brand {
+  display: flex;
+}
+
+.shell--streaming .topbar-search {
+  display: inline-flex;
+  justify-content: center;
+  width: 38px;
+  min-width: 38px;
+  padding-inline: 0;
+}
+
+.shell--streaming .topbar-search__label,
+.shell--streaming .topbar-search__shortcut {
+  display: none;
+}
+
+.shell--streaming .chat {
+  --chat-thread-max-width: min(60ch, calc(100vw - 2rem));
+  --chat-text-size: max(18px, calc(18px * var(--control-ui-text-scale)));
+  --chat-text: var(--text-strong);
+  --chat-message-max-width: 100%;
+}
+
+.shell--streaming .chat-text {
+  line-height: 1.6;
+  text-align: start;
+}
+
+.shell--streaming .chat-text :where(p, ul, ol) {
+  margin-block-end: 1.5em;
+}
+
+.shell--streaming .chat-text :where(h1, h2) {
+  font-size: max(24px, 1.5em);
+}
+
+@media (max-width: 560px) {
+  .shell--streaming .topbar-brand__title {
+    display: none;
+  }
+}
+
+@media (max-height: 600px) {
+  .shell--streaming .chat-footer {
+    --chat-footer-max-height: 40cqh;
+  }
+}
