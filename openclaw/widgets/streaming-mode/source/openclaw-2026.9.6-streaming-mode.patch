diff --git a/ui/src/styles/streaming-mode.css b/ui/src/styles/streaming-mode.css
new file mode 100644
index 00000000..7438aba2
--- /dev/null
+++ b/ui/src/styles/streaming-mode.css
@@ -0,0 +1,62 @@
+/* Streaming Mode reuses the shell's responsive drawer and affects only the
+   active browser view. Existing theme tokens provide contrast in both modes. */
+.sidebar-streaming-toggle,
+.topbar-streaming-toggle,
+.streaming-composer-toggle {
+  min-height: 36px;
+}
+
+.sidebar-streaming-toggle {
+  width: 100%;
+  margin-bottom: 4px;
+}
+
+.shell--streaming .chat {
+  --chat-thread-max-width: min(60ch, calc(100vw - 2rem));
+  --chat-text-size: max(18px, calc(18px * var(--control-ui-text-scale)));
+  --chat-text: var(--text-strong);
+  --chat-message-max-width: 100%;
+}
+
+.shell--streaming .chat-text {
+  line-height: 1.6;
+  text-align: start;
+}
+
+.shell--streaming .chat-text :where(p, ul, ol) {
+  margin-block-end: 1.5em;
+}
+
+.shell--streaming .chat-text :where(h1, h2) {
+  font-size: max(24px, 1.5em);
+}
+
+.streaming-composer-toggle {
+  display: none;
+  align-self: center;
+  margin: 4px 0;
+}
+
+.shell--streaming .streaming-composer-toggle {
+  display: block;
+}
+
+.shell--streaming .chat-footer--streaming-collapsed > :not(.streaming-composer-toggle) {
+  display: none;
+}
+
+.shell--streaming .chat-footer--streaming-collapsed::before {
+  display: none;
+}
+
+@media (max-width: 560px) {
+  .shell--streaming .topbar-brand__title {
+    display: none;
+  }
+}
+
+@media (max-height: 600px) {
+  .shell--streaming .chat-footer:not(.chat-footer--streaming-collapsed) {
+    --chat-footer-max-height: 40cqh;
+  }
+}
