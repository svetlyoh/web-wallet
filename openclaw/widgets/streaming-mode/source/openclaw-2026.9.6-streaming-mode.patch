diff --git a/ui/src/e2e/streaming-mode.e2e.test.ts b/ui/src/e2e/streaming-mode.e2e.test.ts
new file mode 100644
index 00000000..e0a7ddba
--- /dev/null
+++ b/ui/src/e2e/streaming-mode.e2e.test.ts
@@ -0,0 +1,78 @@
+import path from "node:path";
+import { expect, it } from "vitest";
+import { installMockGateway } from "../test-helpers/control-ui-e2e.ts";
+import { createControlUiE2eSuite } from "./control-ui-e2e-suite.test-support.ts";
+
+const suite = createControlUiE2eSuite({
+  name: "Streaming Mode composer interaction mocked Gateway E2E",
+  startServerBeforeBrowser: true,
+});
+const qaDir = process.env.OPENCLAW_STREAMING_MODE_QA_DIR?.trim();
+
+async function capture(page: import("playwright").Page, fileName: string) {
+  if (qaDir) {
+    await page.screenshot({ animations: "disabled", path: path.join(qaDir, fileName) });
+  }
+}
+
+suite.define(() => {
+  it("keeps the standard composer editable before, during, and after Streaming Mode", async () => {
+    await suite.withPage(
+      {
+        locale: "en-US",
+        serviceWorkers: "block",
+        viewport: { height: 720, width: 1280 },
+      },
+      async ({ page }) => {
+        await installMockGateway(page);
+        await page.goto(`${suite.server.baseUrl}chat`);
+
+        const shell = page.locator(".shell");
+        const composer = page.locator(".agent-chat__composer-combobox textarea");
+        await composer.waitFor();
+        await page.evaluate(() => {
+          const host = [...document.querySelectorAll("openclaw-plugin-contributions")].find(
+            (element) => (element as HTMLElement & { kind?: string }).kind === "session-header",
+          );
+          if (!host) {
+            throw new Error("Missing the session-header plugin accessory host");
+          }
+          const probe = document.createElement("button");
+          probe.dataset.streamingGearProbe = "true";
+          probe.textContent = "Activity gears";
+          host.append(probe);
+        });
+        const gearProbe = page.locator('[data-streaming-gear-probe="true"]');
+        expect(await gearProbe.isVisible()).toBe(true);
+        await composer.fill("before streaming");
+        expect(await composer.inputValue()).toBe("before streaming");
+        await capture(page, "normal-1280x720.png");
+
+        await page.getByRole("button", { name: "Streaming Mode", exact: true }).click();
+        await expect.poll(() => shell.getAttribute("class")).toContain("shell--streaming");
+        await composer.fill("during streaming");
+        expect(await composer.inputValue()).toBe("during streaming");
+        expect(await composer.isEditable()).toBe(true);
+        expect(await gearProbe.isVisible()).toBe(true);
+        await capture(page, "streaming-1280x720.png");
+
+        await page.setViewportSize({ height: 400, width: 800 });
+        expect(await composer.isEditable()).toBe(true);
+        expect(await gearProbe.isVisible()).toBe(true);
+        await capture(page, "streaming-short-800x400.png");
+
+        await page.setViewportSize({ height: 844, width: 390 });
+        expect(await composer.isEditable()).toBe(true);
+        expect(await gearProbe.isVisible()).toBe(true);
+        await capture(page, "streaming-phone-390x844.png");
+
+        await page.getByRole("button", { name: "Exit Streaming Mode", exact: true }).click();
+        await expect.poll(() => shell.getAttribute("class")).not.toContain("shell--streaming");
+        await composer.fill("after streaming");
+        expect(await composer.inputValue()).toBe("after streaming");
+        expect(await composer.isEditable()).toBe(true);
+        expect(await gearProbe.isVisible()).toBe(true);
+      },
+    );
+  });
+});
