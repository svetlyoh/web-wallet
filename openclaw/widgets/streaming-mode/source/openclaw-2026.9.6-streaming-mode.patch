diff --git a/ui/src/app/streaming-mode.test.ts b/ui/src/app/streaming-mode.test.ts
new file mode 100644
index 00000000..37d57de9
--- /dev/null
+++ b/ui/src/app/streaming-mode.test.ts
@@ -0,0 +1,48 @@
+/* @vitest-environment jsdom */
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createStorageMock } from "../test-helpers/storage.ts";
+
+async function importStreamingMode() {
+  vi.resetModules();
+  return await import("./streaming-mode.ts");
+}
+
+describe("streaming mode preference", () => {
+  afterEach(() => {
+    vi.unstubAllGlobals();
+  });
+
+  it("defaults off, persists changes, and restores the saved mode", async () => {
+    const storage = createStorageMock();
+    vi.stubGlobal("localStorage", storage);
+
+    const initial = await importStreamingMode();
+    expect(initial.isStreamingMode()).toBe(false);
+
+    initial.setStreamingMode(true);
+    expect(initial.isStreamingMode()).toBe(true);
+    expect(storage.getItem("openclaw.streamingMode")).toBe("true");
+
+    const restored = await importStreamingMode();
+    expect(restored.isStreamingMode()).toBe(true);
+
+    restored.setStreamingMode(false);
+    expect(storage.getItem("openclaw.streamingMode")).toBe("false");
+  });
+
+  it("keeps the in-memory view usable when storage throws", async () => {
+    vi.stubGlobal("localStorage", {
+      getItem() {
+        throw new Error("blocked");
+      },
+      setItem() {
+        throw new Error("blocked");
+      },
+    });
+
+    const mode = await importStreamingMode();
+    expect(mode.isStreamingMode()).toBe(false);
+    expect(() => mode.setStreamingMode(true)).not.toThrow();
+    expect(mode.isStreamingMode()).toBe(true);
+  });
+});
diff --git a/ui/src/app/streaming-mode.ts b/ui/src/app/streaming-mode.ts
new file mode 100644
index 00000000..a26d4b0e
--- /dev/null
+++ b/ui/src/app/streaming-mode.ts
@@ -0,0 +1,23 @@
+import { getSafeLocalStorage } from "../local-storage.ts";
+
+const STORAGE_KEY = "openclaw.streamingMode";
+
+let enabled = false;
+try {
+  enabled = getSafeLocalStorage()?.getItem(STORAGE_KEY) === "true";
+} catch {
+  // Privacy settings can make storage reads fail.
+}
+
+export function isStreamingMode(): boolean {
+  return enabled;
+}
+
+export function setStreamingMode(value: boolean): void {
+  enabled = value;
+  try {
+    getSafeLocalStorage()?.setItem(STORAGE_KEY, String(value));
+  } catch {
+    // The view remains usable when browser storage is unavailable.
+  }
+}
